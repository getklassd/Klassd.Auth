<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Klassd.Auth.Migration</PackageId>
    <Description>Importers that migrate users INTO Klassd.Auth from Auth0 and SuperTokens — maps their export/bulk-import formats onto Klassd users, links third-party identities, carries roles/metadata/TOTP, and verifies legacy bcrypt/argon2 password hashes at login. AddAuthMigration().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klassd.Auth.Core\Klassd.Auth.Core.csproj" />
  </ItemGroup>

</Project>
