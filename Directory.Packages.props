<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Single source of truth for package versions across the solution (pinned). -->
  <ItemGroup>
    <!-- Extensions / framework abstractions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />

    <!-- Tokens / crypto -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.0" />

    <!-- SSO / external login -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.8" />

    <!-- Passkeys (WebAuthn/FIDO2) -->
    <PackageVersion Include="Fido2.AspNet" Version="4.0.1" />

    <!-- SMS provider (passwordless over SMS) -->
    <PackageVersion Include="Twilio" Version="7.14.9" />

    <!-- Migration: verify legacy bcrypt/argon2 password hashes from Auth0 / SuperTokens at login -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />

    <!-- Migration: read a SuperTokens core DB directly (Postgres reuses Npgsql above) -->
    <PackageVersion Include="MySqlConnector" Version="2.6.0" />

    <!-- Storage adapters (raw drivers, no EF/ORM — matches Klassd house convention) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MongoDB.Driver" Version="3.9.0" />

    <!-- Testing -->
    <PackageVersion Include="TUnit" Version="1.47.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
    <PackageVersion Include="TUnit.Playwright" Version="1.47.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.12.0" />
  </ItemGroup>

</Project>
